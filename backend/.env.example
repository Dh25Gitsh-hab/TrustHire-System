# ------------------------------------------------------------------
# Copy this file to ".env" and fill in the values.
# The .env file is NOT committed to Git (it is listed in .gitignore),
# so the keys below stay on your machine.
#
# Every third-party service is OPTIONAL: leave its keys empty and that
# feature is simply switched off — the rest of the API keeps working.
# ------------------------------------------------------------------

# Frontend address(es) allowed to call the API, comma-separated.
# Vite's dev server runs on http://localhost:5173 by default.
ALLOWED_ORIGINS=http://localhost:5173

# Seconds to wait for an external website / WHOIS server / API before giving up.
HTTP_TIMEOUT_SECONDS=10

# --- Supabase (database) -------------------------------------------
# Project Settings -> API. Use the SECRET key (or legacy service_role key).
# Never put this key in the frontend.
SUPABASE_URL=
SUPABASE_KEY=

# --- SerpApi (reputation check: Google search results as JSON) -------
# serpapi.com -> sign up (Free plan: 250 searches/month, 50/hour)
# -> Dashboard -> "Your Private API Key".
SERPAPI_API_KEY=
# Searches per analysis (each uses 1 free search). 3 = about 80 analyses/month.
# MAX_SEARCHES_PER_ANALYSIS=3

# --- Google Gemini (reputation check: AI reads the search results) ---
# aistudio.google.com -> "Get API key". Do NOT set up billing: without
# billing the key stays on the free tier.
GEMINI_API_KEY=
# A model your free tier lists (AI Studio shows your models and limits).
GEMINI_MODEL=gemini-3.5-flash-lite
# Less "thinking" = faster answers. Allowed values depend on the model.
# GEMINI_THINKING_LEVEL=low
# GEMINI_TIMEOUT_SECONDS=60

# Hours to remember search results and AI answers (saves the free quota).
# EVIDENCE_CACHE_HOURS=24

# --- data.gov.in (MCA company registration check) --------------------
# Register on data.gov.in -> My Account -> generate API key.
DATAGOVIN_API_KEY=
# Defaults are already set in app/config.py; only change them if
# data.gov.in renames the dataset or its columns.
# MCA_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a
# MCA_NAME_FIELD=CompanyName
