# ------------------------------------------------------------------
# Copy this file to ".env" if you need to change the defaults.
#
# IMPORTANT: every VITE_ variable is PUBLIC — it is built into the
# JavaScript that every visitor downloads. Never put API keys or secrets
# here (SerpApi, Gemini, Supabase, data.gov.in keys stay in backend/.env).
# ------------------------------------------------------------------

# Address of the TrustHire backend (FastAPI). Default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
